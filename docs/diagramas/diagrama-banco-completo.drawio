        <mxCell id="data_availability" value="&lt;b&gt;data_availability&lt;/b&gt;&lt;br&gt;PK id : SERIAL&lt;br&gt;FK source_id : INTEGER NOT NULL UNIQUE&lt;br&gt;status : SourceAvailabilityStatus NOT NULL DEFAULT UNKNOWN&lt;br&gt;message : TEXT NULL&lt;br&gt;checked_at : TIMESTAMP NULL&lt;br&gt;created_at : TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP&lt;br&gt;updated_at : TIMESTAMP NOT NULL&lt;br&gt;&lt;br&gt;Indices:&lt;br&gt;- UNIQUE(source_id)&lt;br&gt;&lt;br&gt;FK:&lt;br&gt;- source_id -&gt; data_sources.id&lt;br&gt;  ON DELETE CASCADE&lt;br&gt;  ON UPDATE CASCADE" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
