        <mxCell id="data_sources" value="&lt;b&gt;data_sources&lt;/b&gt;&lt;br&gt;PK id : SERIAL&lt;br&gt;name : VARCHAR(255) NOT NULL&lt;br&gt;slug : VARCHAR(100) NOT NULL UNIQUE&lt;br&gt;system : VARCHAR(100) NOT NULL&lt;br&gt;category : VARCHAR(100) NOT NULL DEFAULT 'epidemiologicas_morbidade'&lt;br&gt;source_url : TEXT NULL&lt;br&gt;municipality_filter_available : BOOLEAN NULL&lt;br&gt;active : BOOLEAN NOT NULL DEFAULT true&lt;br&gt;created_at : TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP&lt;br&gt;updated_at : TIMESTAMP NOT NULL&lt;br&gt;&lt;br&gt;Indices:&lt;br&gt;- UNIQUE(slug)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
