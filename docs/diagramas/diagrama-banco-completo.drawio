        <mxCell id="epidemiological_records" value="&lt;b&gt;epidemiological_records&lt;/b&gt;&lt;br&gt;PK id : SERIAL&lt;br&gt;FK source_id : INTEGER NOT NULL&lt;br&gt;FK sync_job_id : INTEGER NULL&lt;br&gt;state : VARCHAR(100) NOT NULL DEFAULT 'Piauí'&lt;br&gt;state_code : VARCHAR(2) NOT NULL DEFAULT 'PI'&lt;br&gt;city : VARCHAR(100) NOT NULL DEFAULT 'Parnaíba'&lt;br&gt;city_ibge_code : VARCHAR(20) NOT NULL DEFAULT '2207702'&lt;br&gt;year : INTEGER NULL&lt;br&gt;month : INTEGER NULL&lt;br&gt;disease_or_condition : VARCHAR(255) NULL&lt;br&gt;metric : VARCHAR(100) NULL&lt;br&gt;value : DECIMAL(18,4) NULL&lt;br&gt;sex : VARCHAR(50) NULL&lt;br&gt;age_group : VARCHAR(100) NULL&lt;br&gt;race_color : VARCHAR(100) NULL&lt;br&gt;dimensions : JSONB NULL&lt;br&gt;source_table : VARCHAR(255) NULL&lt;br&gt;record_key : VARCHAR(128) NOT NULL UNIQUE&lt;br&gt;imported_at : TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP&lt;br&gt;&lt;br&gt;Indices:&lt;br&gt;- UNIQUE(record_key)&lt;br&gt;- INDEX(source_id, year)&lt;br&gt;- INDEX(source_id, year, sex)&lt;br&gt;- INDEX(source_id, year, age_group)&lt;br&gt;- INDEX(source_id, disease_or_condition)&lt;br&gt;- INDEX(imported_at)&lt;br&gt;&lt;br&gt;FK:&lt;br&gt;- source_id -&gt; data_sources.id&lt;br&gt;  ON DELETE CASCADE&lt;br&gt;  ON UPDATE CASCADE&lt;br&gt;- sync_job_id -&gt; sync_jobs.id&lt;br&gt;  ON DELETE SET NULL&lt;br&gt;  ON UPDATE CASCADE" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
