{
  "name": "@painel-parnaiba/backend",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "build:seed": "tsc -p tsconfig.seed.json",
    "test": "node --import tsx --test src/routes/public-api.test.ts src/modules/datasus/period-files.test.ts src/modules/population/population.test.ts src/modules/public/indicators.test.ts",
    "start": "node dist/main.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "prisma db seed",
    "seed:prod": "node dist/prisma/seed.js",
    "sync:data:prod": "node dist/scripts/sync-data.js",
    "prisma:studio": "prisma studio",
    "sync:data": "tsx src/scripts/sync-data.ts",
    "sync:tuberculose": "tsx src/scripts/sync-data.ts tuberculose_sinan",
    "sync:hanseniase": "tsx src/scripts/sync-data.ts hanseniase_sinan",
    "sync:sifilis": "tsx src/scripts/sync-data.ts sifilis_congenita_sinan",
    "sync:sifilis-gestacional": "tsx src/scripts/sync-data.ts sifilis_gestacional_sinan"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
