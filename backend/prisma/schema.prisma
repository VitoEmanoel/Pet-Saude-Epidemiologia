generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SourceAvailabilityStatus {
  UNKNOWN
  AVAILABLE
  MUNICIPAL_FILTER_UNAVAILABLE
  NO_RECORDS_FOR_CITY
  ERROR
}

enum SyncJobStatus {
  PENDING
  RUNNING
  SUCCESS
  PARTIAL_SUCCESS
  FAILED
  UNAVAILABLE
  SKIPPED
}

model DataSource {
  id                          Int                       @id @default(autoincrement())
  name                        String                    @db.VarChar(255)
  slug                        String                    @unique @db.VarChar(100)
  system                      String                    @db.VarChar(100)
  category                    String                    @default("epidemiologicas_morbidade") @db.VarChar(100)
  sourceUrl                   String?                   @map("source_url")
  municipalityFilterAvailable Boolean?                  @map("municipality_filter_available")
  active                      Boolean                   @default(true)
  createdAt                   DateTime                  @default(now()) @map("created_at")
  updatedAt                   DateTime                  @updatedAt @map("updated_at")

  availability                DataAvailability?
  syncJobs                    SyncJob[]
  classificationCounts        ClassificationCount[]
  syncLock                    SyncLock?
  rawImports                  RawImport[]
  records                     EpidemiologicalRecord[]

  @@map("data_sources")
}

model DataAvailability {
  id        Int                      @id @default(autoincrement())
  sourceId  Int                      @unique @map("source_id")
  status    SourceAvailabilityStatus @default(UNKNOWN)
  message   String?
  checkedAt DateTime?                @map("checked_at")
  createdAt DateTime                 @default(now()) @map("created_at")
  updatedAt DateTime                 @updatedAt @map("updated_at")

  source    DataSource               @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@map("data_availability")
}

model SyncJob {
  id              Int           @id @default(autoincrement())
  sourceId        Int?          @map("source_id")
  status          SyncJobStatus @default(PENDING)
  startedAt       DateTime?     @map("started_at")
  finishedAt      DateTime?     @map("finished_at")
  recordsImported Int           @default(0) @map("records_imported")
  errorMessage    String?       @map("error_message")
  requestedBy     String?       @map("requested_by")
  createdAt       DateTime      @default(now()) @map("created_at")

  source          DataSource?   @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  rawImports      RawImport[]
  records         EpidemiologicalRecord[]
  classificationCounts ClassificationCount[]

  @@index([sourceId])
  @@index([status])
  @@index([createdAt])
  @@map("sync_jobs")
}

model AdminAuditLog {
  id        Int      @id @default(autoincrement())
  actor     String   @default("admin") @db.VarChar(100)
  action    String   @db.VarChar(100)
  status    String   @db.VarChar(50)
  ipAddress String?  @map("ip_address") @db.VarChar(100)
  userAgent String?  @map("user_agent")
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([action])
  @@index([status])
  @@index([createdAt])
  @@map("admin_audit_logs")
}

// Sessões do admin: o cookie assinado guarda o id; o logout preenche revokedAt (S11).
model AdminSession {
  id        String    @id @db.VarChar(64)
  createdAt DateTime  @default(now()) @map("created_at")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")

  @@index([expiresAt])
  @@map("admin_sessions")
}

model RawImport {
  id             Int      @id @default(autoincrement())
  sourceId       Int      @map("source_id")
  syncJobId      Int?     @map("sync_job_id")
  requestUrl     String?  @map("request_url")
  requestParams  Json?    @map("request_params")
  responseFormat String?  @map("response_format") @db.VarChar(50)
  contentHash    String?  @map("content_hash") @db.VarChar(128)
  storedPath     String?  @map("stored_path")
  rowCount       Int      @default(0) @map("row_count")
  importedAt     DateTime @default(now()) @map("imported_at")

  source         DataSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  syncJob        SyncJob?   @relation(fields: [syncJobId], references: [id], onDelete: SetNull)

  @@index([sourceId])
  @@index([syncJobId])
  @@index([contentHash])
  @@map("raw_imports")
}

model EpidemiologicalRecord {
  id                 Int      @id @default(autoincrement())
  sourceId           Int      @map("source_id")
  syncJobId          Int?     @map("sync_job_id")

  state              String   @default("Piauí") @db.VarChar(100)
  stateCode          String   @default("PI") @map("state_code") @db.VarChar(2)
  city               String   @default("Parnaíba") @db.VarChar(100)
  cityIbgeCode       String   @default("2207702") @map("city_ibge_code") @db.VarChar(20)

  year               Int?
  month              Int?
  diseaseOrCondition String?  @map("disease_or_condition") @db.VarChar(255)
  metric             String?  @db.VarChar(100)
  value              Decimal? @db.Decimal(18, 4)

  sex                String?  @db.VarChar(50)
  ageGroup           String?  @map("age_group") @db.VarChar(100)
  raceColor          String?  @map("race_color") @db.VarChar(100)
  dimensions         Json?

  sourceTable        String?  @map("source_table") @db.VarChar(255)
  recordKey          String   @unique @map("record_key") @db.VarChar(128)
  importedAt         DateTime @default(now()) @map("imported_at")

  source             DataSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  syncJob            SyncJob?   @relation(fields: [syncJobId], references: [id], onDelete: SetNull)

  @@index([sourceId, year])
  @@index([sourceId, year, sex])
  @@index([sourceId, year, ageGroup])
  @@index([sourceId, diseaseOrCondition])
  @@index([importedAt])
  @@map("epidemiological_records")
}

// População residente de Parnaíba por ano, enviada pelo admin em planilha CSV (A4).
// Base dos indicadores (incidência por 100 mil habitantes).
model PopulationEstimate {
  id               Int      @id @default(autoincrement())
  year             Int      @unique
  population       Int
  population60Plus Int?     @map("population_60_plus")
  sourceNote       String?  @map("source_note") @db.VarChar(200)
  updatedBy        String?  @map("updated_by") @db.VarChar(100)
  updatedAt        DateTime @default(now()) @map("updated_at")

  @@map("population_estimates")
}

// Casos por classificação final, por ano (A5): base da % de dengue com sinais de alarme
// e grave, e dos casos confirmados de zika e chikungunya. Separada de epidemiological_records
// para a tabela e o CSV públicos não contarem o mesmo caso mais uma vez.
model ClassificationCount {
  id             Int      @id @default(autoincrement())
  sourceId       Int      @map("source_id")
  syncJobId      Int?     @map("sync_job_id")
  year           Int
  classification String   @db.VarChar(100)
  value          Decimal  @db.Decimal(14, 4)
  importedAt     DateTime @default(now()) @map("imported_at")

  source         DataSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  syncJob        SyncJob?   @relation(fields: [syncJobId], references: [id], onDelete: SetNull)

  @@unique([sourceId, year, classification])
  @@map("classification_counts")
}


/// Trava de sincronização (O3): uma linha por fonte enquanto ela sincroniza. Vale entre
/// processos (API, agendador, linha de comando); expira se o processo morrer no meio.
model SyncLock {
  sourceId   Int        @id @map("source_id")
  owner      String     @db.VarChar(100)
  acquiredAt DateTime   @default(now()) @map("acquired_at")

  source     DataSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@map("sync_locks")
}
