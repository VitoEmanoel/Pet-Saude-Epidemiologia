NODE_ENV=development
HOST=0.0.0.0
APP_BIND_HOST=0.0.0.0
SERVICE_BIND_HOST=127.0.0.1

FRONTEND_PORT=3000
BACKEND_PORT=3333
PORT=3333

FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:3333
NEXT_PUBLIC_API_URL=http://localhost:3333
VITE_API_URL=http://localhost:3333
CORS_ORIGIN=http://localhost:3000

ADMIN_USERNAME=admin
ADMIN_PASSWORD=1234
ADMIN_SESSION_SECRET=1234
ADMIN_COOKIE_SECURE=false

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=pet_saude
POSTGRES_PORT=5433

DATABASE_URL=postgresql://postgres:postgres@postgres:5432/pet_saude?schema=public

REDIS_URL=redis://redis:6379
REDIS_PORT=6379

SYNC_SCHEDULE_ENABLED=true
SYNC_SCHEDULE_INTERVAL_DAYS=30
SYNC_SCHEDULE_CHECK_INTERVAL_MINUTES=1440
SYNC_SCHEDULE_STARTUP_DELAY_SECONDS=30
RUN_INITIAL_SYNC=false
