NODE_ENV=development
HOST=0.0.0.0
APP_BIND_HOST=0.0.0.0
SERVICE_BIND_HOST=127.0.0.1

FRONTEND_PORT=3000
BACKEND_PORT=3333
PORT=3333

FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:3333
NEXT_PUBLIC_API_URL=http://localhost:3333
VITE_API_URL=http://localhost:3333
CORS_ORIGIN=http://localhost:3000

ADMIN_USERNAME=admin
ADMIN_PASSWORD=troque-esta-senha
ADMIN_SESSION_SECRET=troque-este-segredo-de-sessao
ADMIN_COOKIE_SECURE=false
# Proxies confiaveis na frente do backend (para descobrir o IP real do visitante).
# Vazio = backend exposto direto. Atras de um proxy (nginx/Caddy): numero de proxies (ex.: 1)
# ou IPs/redes deles (ex.: loopback, 172.16.0.0/12). Nunca use "true".
TRUST_PROXY=
# Limite de requisicoes por minuto por IP na API (0 desliga). IPs de rede privada nao sao limitados.
RATE_LIMIT_PER_MINUTE=600

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=pet_saude
POSTGRES_PORT=5433

DATABASE_URL=postgresql://postgres:postgres@postgres:5432/pet_saude?schema=public

SYNC_SCHEDULE_ENABLED=true
SYNC_SCHEDULE_INTERVAL_DAYS=30
SYNC_SCHEDULE_CHECK_INTERVAL_MINUTES=1440
SYNC_SCHEDULE_STARTUP_DELAY_SECONDS=30
RUN_INITIAL_SYNC=false
