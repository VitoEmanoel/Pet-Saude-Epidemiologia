# .env de produção (copie para deploy/.env.producao no seu computador e para /opt/painel/.env na VPS).
# NUNCA versione o arquivo preenchido. Gere segredos com: openssl rand -base64 32

# Endereço público (HTTPS feito pelo proxy da UESPI). Site e API no mesmo domínio.
FRONTEND_URL=https://victorsilva0001.cloud.deploy.uespi.br
BACKEND_URL=https://victorsilva0001.cloud.deploy.uespi.br/painel
# Embutido no build do frontend (e na CSP): construa as imagens com este valor.
NEXT_PUBLIC_API_URL=https://victorsilva0001.cloud.deploy.uespi.br/painel
CORS_ORIGIN=https://victorsilva0001.cloud.deploy.uespi.br

# Painel fora da raiz do domínio, dividindo o endereço com outro sistema da VPS
# (docs/16-implantacao.md §16.9). Para o painel ocupar o domínio todo, deixe os três vazios
# (ou CADDYFILE=Caddyfile) e tire o /painel das URLs acima.
NEXT_PUBLIC_BASE_PATH=/painel
PUBLIC_BASE_PATH=/painel
CADDYFILE=Caddyfile.subcaminho
# Para onde vai o resto do domínio (o TSCQuestões, movido para a porta 3100 da VPS).
OUTRO_SITE=host.docker.internal:3100

# Porta da VPS em que o Caddy escuta (a que o proxy da UESPI chama).
PUBLIC_PORT=80
PUBLIC_BIND_HOST=0.0.0.0

ADMIN_USERNAME=admin
# 12+ caracteres
ADMIN_PASSWORD=
# 32+ caracteres
ADMIN_SESSION_SECRET=
ADMIN_COOKIE_SECURE=true

# Proxies confiáveis: o Caddy (rede do Docker) e o proxy da UESPI (rede interna).
TRUST_PROXY="loopback, uniquelocal"
RATE_LIMIT_PER_MINUTE=600

POSTGRES_USER=postgres
# 12+ caracteres, diferente de "postgres"
POSTGRES_PASSWORD=
POSTGRES_DB=pet_saude

SYNC_SCHEDULE_ENABLED=true
SYNC_SCHEDULE_INTERVAL_DAYS=30
SYNC_SCHEDULE_CHECK_INTERVAL_MINUTES=60
SYNC_SCHEDULE_STARTUP_DELAY_SECONDS=60

# Backup diário do banco em /opt/painel/backups
BACKUP_KEEP_DAYS=14
BACKUP_INTERVAL_SECONDS=86400
