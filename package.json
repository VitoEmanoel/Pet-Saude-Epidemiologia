{
  "name": "painel-epidemiologico-parnaiba",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "bash ./scripts/start.sh",
    "doctor": "bash ./scripts/doctor.sh",
    "db:reset": "bash ./scripts/db-reset.sh",
    "docker:recover": "bash ./scripts/recover-docker.sh",
    "stop": "bash ./scripts/stop.sh",
    "logs": "bash ./scripts/logs.sh",
    "restart": "bash ./scripts/restart.sh",
    "dev:backend": "npm --workspace backend run dev",
    "dev:frontend": "npm --workspace frontend run dev",
    "build:backend": "npm --workspace backend run build",
    "build:frontend": "npm --workspace frontend run build",
    "test:backend": "npm --workspace backend run test",
    "test:setup": "npm --prefix tests run setup",
    "test:e2e": "npm --prefix tests run e2e",
    "test:ui": "npm --prefix tests run ui",
    "test:ui:webkit": "docker run --rm --network host --ipc=host --user \"$(id -u):$(id -g)\" -e HOME=/tmp -e QA_BROWSER=webkit -v \"$PWD\":/repo -w /repo/tests mcr.microsoft.com/playwright:v1.63.0-noble node --test --test-concurrency=1 ui/ui.test.mjs",
    "test:load": "npm --prefix tests run load",
    "test:soak": "npm --prefix tests run soak",
    "test:resilience": "npm --workspace backend exec -- tsx ../tests/resilience/fault-injection.ts",
    "prisma:generate": "npm --workspace backend run prisma:generate",
    "prisma:migrate": "npm --workspace backend run prisma:migrate",
    "prisma:deploy": "npm --workspace backend run prisma:deploy",
    "prisma:seed": "npm --workspace backend run prisma:seed",
    "sync:data": "bash ./scripts/sync-data.sh",
    "sync:data:backend": "npm --workspace backend run sync:data",
    "sync:tuberculose": "npm --workspace backend run sync:tuberculose",
    "sync:hanseniase": "npm --workspace backend run sync:hanseniase",
    "sync:sifilis": "npm --workspace backend run sync:sifilis"
  },
  "overrides": {
    "next": {
      "postcss": "^8.5.28"
    }
  }
}
